\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces E6 multi-family replication accuracy (open-weight Meta, DeepSeek and Qwen models) (\%; $n=210$ items, 30 per category) with 95\% cluster-bootstrap confidence intervals (categories as clusters; 3000 resamples), the paired situation$-$structured contrast, and cost. A contrast interval that excludes zero is a directional estimate only within this bounded analysis.}}{25}{table.ED.2}\protected@file@percent }
\newlabel{tab:e6-stats}{{2}{25}{E6 multi-family replication accuracy (open-weight Meta, DeepSeek and Qwen models) (\%; $n=210$ items, 30 per category) with 95\% cluster-bootstrap confidence intervals (categories as clusters; 3000 resamples), the paired situation$-$structured contrast, and cost. A contrast interval that excludes zero is a directional estimate only within this bounded analysis}{table.ED.2}{}}
