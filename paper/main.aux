\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces E5 accuracy with 95\% cluster-bootstrap confidence intervals (categories as clusters; 3000 resamples), the paired situation$-$structured contrast, and cost. CIs that exclude zero are the only ones that license a directional claim.}}{10}{table.3}\protected@file@percent }
\newlabel{tab:e5-stats}{{3}{10}{E5 accuracy with 95\% cluster-bootstrap confidence intervals (categories as clusters; 3000 resamples), the paired situation$-$structured contrast, and cost. CIs that exclude zero are the only ones that license a directional claim}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Retrieval-augmented (RAG) baseline versus full-evidence prompting, mean accuracy over the three Gemini models on the $n=210$ sample. RAG answers from the top-3 lexically retrieved claims (plain text); Structured and Situation see all claims. On the two categories that most require reasoning over the applicability state -- temporal validity and observer knowledge -- the full-state conditions beat RAG; elsewhere a focused RAG is as good or better, and its aggregate lead is driven by clarification (hidden premise), where the plain prompt elicits the CLARIFY token more readily.}}{11}{table.4}\protected@file@percent }
\newlabel{tab:e5-rag}{{4}{11}{Retrieval-augmented (RAG) baseline versus full-evidence prompting, mean accuracy over the three Gemini models on the $n=210$ sample. RAG answers from the top-3 lexically retrieved claims (plain text); Structured and Situation see all claims. On the two categories that most require reasoning over the applicability state -- temporal validity and observer knowledge -- the full-state conditions beat RAG; elsewhere a focused RAG is as good or better, and its aggregate lead is driven by clarification (hidden premise), where the plain prompt elicits the CLARIFY token more readily}{table.4}{}}
