\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Retrieval-augmented (RAG), full-evidence prompting, and a tool-using agent, mean accuracy over the three Gemini models on the $n=210$ sample. RAG answers from the top-3 lexically retrieved claims; Structured and Situation see all claims; Agent may issue its own search queries over the item's claims before answering. Descriptively, on the two categories that most require reasoning over the applicability state -- temporal validity and observer knowledge -- the full-evidence conditions score above both retrieval and the agent; this category-level pattern is exploratory, and none of the retrieval-, prompt-, or tool-based interventions dominates overall.}}{22}{table.ED.2}\protected@file@percent }
\newlabel{tab:e5-rag}{{2}{22}{Retrieval-augmented (RAG), full-evidence prompting, and a tool-using agent, mean accuracy over the three Gemini models on the $n=210$ sample. RAG answers from the top-3 lexically retrieved claims; Structured and Situation see all claims; Agent may issue its own search queries over the item's claims before answering. Descriptively, on the two categories that most require reasoning over the applicability state -- temporal validity and observer knowledge -- the full-evidence conditions score above both retrieval and the agent; this category-level pattern is exploratory, and none of the retrieval-, prompt-, or tool-based interventions dominates overall}{table.ED.2}{}}
